{
  "name": "tinycode",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal but complete Coding Agent Harness built on the Pi Agent SDK",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "tinycode": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden": "tsx scripts/generate-golden.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "ignore": "^7.0.12",
    "typebox": "^1.3.37",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
