{
  "name": "tinycode-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop host for the TinyCode coding agent harness",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:e2e": "npm run build && playwright test --config tests/playwright.config.ts"
  },
  "dependencies": {
    "tinycode": "file:.."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.8.0",
    "vite": "^8.3.4"
  }
}
